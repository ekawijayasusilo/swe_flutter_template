# Copy this file to .env and fill in your API key there; never commit the real key.
# Enable the Developer Knowledge API and restrict this key to that API.
# Setup: https://developers.google.com/knowledge/mcp
# Both MCP configs run scripts/mcp-headers.cjs with Node's --env-file (Node 20.6+).
# Start Claude Code and Pi from the project root; no npm or pub loader is needed.
# An existing DEVELOPER_KNOWLEDGE_API_KEY environment variable takes precedence.
DEVELOPER_KNOWLEDGE_API_KEY=
