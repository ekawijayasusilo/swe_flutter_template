{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared policy from proto_codecare_scripts. Keep both refs on the same tag; Renovate bumps them.
  extends: [
    "github>ekawijayasusilo/proto_codecare_scripts//version-control/renovate-configs/default#v1.1.0",
    "github>ekawijayasusilo/proto_codecare_scripts//version-control/renovate-configs/flutter.json5#v1.1.0",
  ],
  // Local workspace package, not published on pub.dev.
  ignoreDeps: ["swe_design_system"],
  // Dependabot owns all security PRs here (.github/dependabot.yaml): Renovate can't fix pub alerts,
  // and handling only GitHub Actions alerts would duplicate Dependabot's PRs.
  vulnerabilityAlerts: { enabled: false },
  packageRules: [
    {
      description: "One PR for all GitHub Actions bumps: actions.lock narrows tags to exact versions (v7 -> v7.0.1), so each patch would otherwise get its own PR. Renovate regenerates actions.lock in the same PR.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: "The lockfile verify action is released as verify/vX.Y.Z tags; its plain vX.Y.Z tags run the previous CLI release.",
      matchManagers: ["github-actions"],
      matchDepNames: ["github/gh-actions-lock"],
      versioning: "regex:^verify/v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
  ],
}
